# Copy to .env.local for local development. Never commit real values.

# LLM provider: "databricks" (default) or "mock" (deterministic, used by Playwright)
LLM_PROVIDER=databricks

# Your Databricks workspace URL (Free Edition works), e.g. https://dbc-a1b2c3d4.cloud.databricks.com
DATABRICKS_HOST=

# Personal access token: Workspace > Settings > Developer > Access tokens.
# Only needed locally — inside Databricks Apps the platform injects OAuth
# credentials (DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET) instead.
DATABRICKS_TOKEN=

# Foundation Model serving endpoint to chat with (must support tool calling).
DATABRICKS_SERVING_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
